{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/security-gate.mjs\""
          }
        ],
        "description": "Deny destructive shell commands, unsafe remote execution pipelines, and uncontrolled force pushes"
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/security-gate.mjs\""
          }
        ],
        "description": "Prevent obvious credentials and private keys from being written to repository files"
      }
    ]
  }
}
